<?xml version="1.0" encoding="utf-8"?>
<!-- The project has zero PackageReferences: every assembly is a direct <Reference> HintPath
     into ..\refs\. There is nothing to download, so no package source is configured.
     This also keeps restore working when the machine's user-level NuGet.Config is unreadable. -->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
