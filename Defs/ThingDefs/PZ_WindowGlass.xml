<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================ Sliding window ============================
       Glazing only, no masonry: a second thing in the half wall's own cell (isEdifice false, so the wall keeps the
       cell's edifice slot; not isAttachment either, since an attachment is shifted a cell off the wall and turned
       round). Two boards in a frame, no glass; the sashes are drawn every frame from Models/pz_window_sash.obj so a
       colonist can slide them (Building_WindowGlass.DrawAt -> WindowSashes.Draw), which is why the thing is
       drawerType RealtimeOnly - and tickerType Normal, because the slide itself is driven in CompWindowLatch.CompTick.

       Buildable from the Structure menu; PlaceWorker_OnHalfWall keeps it to half walls. canPlaceOverWall
       lets the blueprint sit on the wall's occupied cell, and the GenSpawn.SpawningWipes patch in this mod stops the
       game from wiping the wall when the window is finished (Patches/WindowNoWallWipe.cs). The half wall's own
       "Fit window" button is gone since 1.1.6: it took the wall's turn, which was not always the right one now that
       half walls are not rotated at all.

       MaxHitPoints 160 is a door's, and the stuff's statFactors scale it exactly as they scale a door's (Flammability
       1.0: wood x1 = 100%, steel x0.4 = 40%; DoorOpenSpeed comes from the stuff: wood x1.2 -> 50 ticks, stone x0.45
       -> 133). Beauty has no statBase either, so it is 0 like a door's.

       Cost and work are NOT a door's any more: a pane in a frame with two sliding boards is not a door. 4 stuff and
       220 work, so a windowed half wall (3 + 4 = 7 stuff, 60 + 220 = 280 work) sits just above a plain wall's 5 and
       135 instead of triple its material and seven times its work (user, 2026-11-09, after the workshop comment
       "a window is somehow double"). -->
  <ThingDef ParentName="BuildingBase">
    <defName>PZ_WindowGlass</defName>
    <label>window</label>
    <description>Glazing fitted on top of a half wall: two boards in a frame, no glass. Open it and a colonist slides the boards apart.</description>
    <thingClass>ProjectZ.Windows.Building_WindowGlass</thingClass>
    <designationCategory>Structure</designationCategory>
    <uiOrder>2011</uiOrder>
    <uiIconPath>ProjectZ/Window_MenuIcon</uiIconPath>
    <placeWorkers>
      <li>ProjectZ.Windows.PlaceWorker_OnHalfWall</li>
    </placeWorkers>
    <graphicData>
      <texPath>ProjectZ/Window</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <linkType>None</linkType>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <drawerType>RealtimeOnly</drawerType>
    <tickerType>Normal</tickerType>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <fillPercent>0</fillPercent>
    <blockLight>false</blockLight>
    <blockWind>false</blockWind>
    <terrainAffordanceNeeded IsNull="True" />
    <rotatable>true</rotatable>
    <useHitPoints>true</useHitPoints>
    <castEdgeShadows>false</castEdgeShadows>
    <statBases>
      <MaxHitPoints>160</MaxHitPoints>
      <WorkToBuild>220</WorkToBuild>
      <Flammability>1.0</Flammability>
    </statBases>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>4</costStuffCount>
    <building>
      <isEdifice>false</isEdifice>
      <isInert>true</isInert>
      <ai_chillDestination>false</ai_chillDestination>
      <canPlaceOverWall>true</canPlaceOverWall>
    </building>
    <comps>
      <li Class="ProjectZ.Windows.CompProperties_WindowLatch" />
    </comps>
  </ThingDef>

  <!-- The open state of the older two-def design. Nothing places it any more: the boards' position is openPct on the
       comp now, and a save that still holds one simply comes back fully open (Building_WindowGlass.OpenDefName). -->
  <ThingDef ParentName="BuildingBase">
    <defName>PZ_WindowGlassOpen</defName>
    <label>window</label>
    <description>Glazing fitted on top of a half wall, slid open.</description>
    <thingClass>ProjectZ.Windows.Building_WindowGlass</thingClass>
    <graphicData>
      <texPath>ProjectZ/Window</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <linkType>None</linkType>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <drawerType>RealtimeOnly</drawerType>
    <tickerType>Normal</tickerType>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <fillPercent>0</fillPercent>
    <blockLight>false</blockLight>
    <blockWind>false</blockWind>
    <terrainAffordanceNeeded IsNull="True" />
    <rotatable>true</rotatable>
    <useHitPoints>true</useHitPoints>
    <castEdgeShadows>false</castEdgeShadows>
    <statBases>
      <MaxHitPoints>160</MaxHitPoints>
      <WorkToBuild>220</WorkToBuild>
      <Flammability>1.0</Flammability>
    </statBases>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>0</costStuffCount>
    <building>
      <isEdifice>false</isEdifice>
      <isInert>true</isInert>
      <ai_chillDestination>false</ai_chillDestination>
      <canPlaceOverWall>true</canPlaceOverWall>
    </building>
    <comps>
      <li Class="ProjectZ.Windows.CompProperties_WindowLatch" />
    </comps>
  </ThingDef>

</Defs>
